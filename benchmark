#!/usr/bin/env sh
set -e
cd "$(dirname "$0")"

usage() {
    cat <<'USAGE'
Usage:
  ./benchmark -full                 Full run, as set in jsvro-core/src/test/resources/benchmark-full.properties
  ./benchmark -ri 10:1000 20:500    Custom run: rows:iterations pairs (at most 100,000 rows and 10,000 iterations)
  ./benchmark -publish              Publish the last run to docs/benchmark and the README (full runs only)

The report is written to jsvro-core/build/reports/jsvro-benchmark/index.html.
USAGE
    exit "$1"
}

case "$1" in
    -full)
        [ "$#" -eq 1 ] || usage 1
        exec ./gradlew :jsvro-core:benchmark -Pbenchmark.full=true
        ;;
    -ri)
        shift
        [ "$#" -gt 0 ] || usage 1
        plan=$(IFS=,; echo "$*")
        exec ./gradlew :jsvro-core:benchmark -Pbenchmark.plan="$plan"
        ;;
    -publish)
        [ "$#" -eq 1 ] || usage 1
        exec ./gradlew :jsvro-core:publishBenchmarkReport
        ;;
    -h | --help)
        usage 0
        ;;
    *)
        usage 1
        ;;
esac
